# Supabase — copy these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_QXjBR0-DFZKIyIAJyNv_rw_MJ-ZAFFv
SUPABASE_LISTING_MEDIA_BUCKET=listing-media

# Google Cloud Storage — private bucket for document uploads (backend/routers/documents.py).
# Reads use short-lived v4 signed URLs, not public object URLs.
# On Cloud Run, the attached service account needs:
#   - roles/storage.objectAdmin on GCS_BUCKET
#   - roles/iam.serviceAccountTokenCreator on itself (needed to sign URLs without a key file)
# For local dev, run `gcloud auth application-default login`, then have your own
# account granted roles/iam.serviceAccountTokenCreator on GCS_SIGNING_SERVICE_ACCOUNT too.
GCS_BUCKET=bogi-property-app-documents
GCS_SIGNING_SERVICE_ACCOUNT=465312640914-compute@developer.gserviceaccount.com

# CORS — comma-separated list of allowed origins (use * for development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:50562,*
